NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/medconsults_crm?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@cluster.mongodb.net/medconsults_crm_test?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace_with_64_character_hex_string_for_access_token_secret
JWT_REFRESH_SECRET=replace_with_different_64_character_hex_string_for_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_username
SMTP_PASS=smtp_password
EMAIL_FROM=MedConsults Clinic <noreply@medconsults.com>
